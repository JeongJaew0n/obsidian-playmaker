{
  "name": "obsidian-playmaker",
  "version": "0.1.0",
  "description": "현재 열린 노트를 터미널 화면처럼 꾸미는 Obsidian 플러그인",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node esbuild.config.mjs",
